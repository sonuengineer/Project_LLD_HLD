# /etc/caddy/Caddyfile
# One block per hostname. Each hostname needs a DNS A record pointing at the server's public IP.
# Caddy gets and renews the HTTPS certificates automatically.
# After editing:  sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy

{
	email you@example.com   # used by Let's Encrypt for expiry notices -- replace
}

# NestJS project (container published on 127.0.0.1:3000)
nest.example.com {
	encode gzip
	reverse_proxy 127.0.0.1:3000
}

# FastAPI project (container published on 127.0.0.1:8000)
api.example.com {
	encode gzip
	reverse_proxy 127.0.0.1:8000
}

# A live demo from Project_LLD_HLD, password protected.
# Make the hash with:  caddy hash-password --plaintext 'your-password'
# demo-ratelimit.example.com {
# 	basic_auth {
# 		viewer <paste-hash-here>
# 	}
# 	reverse_proxy 127.0.0.1:58001
# }

# WebSocket apps (e.g. the collaborative editor) need nothing extra: reverse_proxy passes upgrades through.
