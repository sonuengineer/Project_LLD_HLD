{
  "name": "dns-resolver",
  "version": "1.0.0",
  "private": true,
  "description": "A hand-written recursive DNS resolver (A6): wire format, iterative resolution from the root, cache, stub server. Zero runtime dependencies.",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "dns-resolver": "dist/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
