{
  "route_groups": {
    "default": ["ip_global", "user_plan"],
    "search": ["ip_global", "user_plan", "search_burst"],
    "login": ["login_bruteforce"],
    "reports": ["ip_global", "reports_smooth"]
  },
  "policies": [
    {
      "name": "ip_global",
      "description": "Anti-abuse guard on every request, keyed on client IP. Sliding counter = O(1) memory.",
      "algorithm": "sliding_counter",
      "scope": "ip",
      "fail_mode": "open",
      "plans": {},
      "default": {"limit": 300, "window_seconds": 60}
    },
    {
      "name": "user_plan",
      "description": "Subscription quota per user (anonymous callers are keyed by IP).",
      "algorithm": "fixed_window",
      "scope": "user",
      "fail_mode": "open",
      "plans": {
        "anonymous": {"limit": 20, "window_seconds": 60},
        "free": {"limit": 60, "window_seconds": 60},
        "pro": {"limit": 600, "window_seconds": 60},
        "enterprise": {"limit": 6000, "window_seconds": 60}
      },
      "default": {"limit": 20, "window_seconds": 60}
    },
    {
      "name": "search_burst",
      "description": "Search is expensive: allow short bursts per API key, then a steady refill.",
      "algorithm": "token_bucket",
      "scope": "api_key",
      "fail_mode": "open",
      "plans": {
        "free": {"limit": 5, "rate_per_second": 0.5},
        "pro": {"limit": 30, "rate_per_second": 5},
        "enterprise": {"limit": 100, "rate_per_second": 20}
      },
      "default": {"limit": 5, "rate_per_second": 0.5}
    },
    {
      "name": "login_bruteforce",
      "description": "Exact sliding log on login attempts per IP. Fails CLOSED: never allow unlimited password guessing.",
      "algorithm": "sliding_log",
      "scope": "ip",
      "fail_mode": "closed",
      "plans": {},
      "default": {"limit": 5, "window_seconds": 60}
    },
    {
      "name": "reports_smooth",
      "description": "Report generation hits a slow downstream; leaky bucket enforces a smooth rate per user.",
      "algorithm": "leaky_bucket",
      "scope": "user",
      "fail_mode": "open",
      "plans": {
        "pro": {"limit": 10, "rate_per_second": 2},
        "enterprise": {"limit": 50, "rate_per_second": 10}
      },
      "default": {"limit": 3, "rate_per_second": 0.2}
    }
  ]
}
