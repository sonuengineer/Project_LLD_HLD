{
  "name": "ratelimit-kit",
  "version": "0.2.0",
  "private": true,
  "description": "Rate limiting for any Node app: token bucket and sliding window counter, in memory or atomically in Redis (Lua); Express middleware and a NestJS decorator. Bring your own Redis client. Zero runtime dependencies.",
  "type": "module",
  "engines": { "node": ">=20" },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./express": "./dist/adapters/express.js",
    "./nestjs": "./dist/adapters/nestjs.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-lua.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": { "optional": true }
  },
  "devDependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@types/express": "4.17.21",
    "@types/node": "20.19.43",
    "express": "4.21.2",
    "ioredis": "5.4.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
