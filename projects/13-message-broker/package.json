{
  "name": "message-broker",
  "version": "1.0.0",
  "private": true,
  "description": "A hand-written NATS-style pub/sub message broker (H12). Zero runtime dependencies.",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "message-broker": "dist/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "nats": "2.29.3",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
