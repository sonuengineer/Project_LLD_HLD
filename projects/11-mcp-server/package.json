{
  "name": "interview-mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "A hand-written MCP (Model Context Protocol) server that exposes the interview question banks",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "interview-mcp": "dist/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "20.19.43",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
