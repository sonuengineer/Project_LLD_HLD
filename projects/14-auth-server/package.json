{
  "name": "auth-server",
  "version": "1.0.0",
  "private": true,
  "description": "A hand-written OAuth 2.0 / OpenID Connect authorization server (H14). Zero runtime dependencies.",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "auth-server": "dist/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "hash-secret": "node dist/hash-secret.js"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "jose": "6.2.15",
    "openid-client": "6.8.9",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
