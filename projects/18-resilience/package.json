{
  "name": "resilience-kit",
  "version": "0.3.0",
  "private": true,
  "description": "Timeout, retry with backoff and a retry budget, circuit breaker, bulkhead, composition and events for any async call. Framework-free core; Express and NestJS adapters as separate entry points. Zero runtime dependencies.",
  "type": "module",
  "engines": { "node": ">=20.3" },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./express": "./dist/adapters/express.js",
    "./nestjs": "./dist/adapters/nestjs.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "npm run build && node bench/overhead.mjs"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": { "optional": true }
  },
  "devDependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@types/express": "4.17.21",
    "@types/node": "20.19.43",
    "cockatiel": "3.2.1",
    "express": "4.21.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
