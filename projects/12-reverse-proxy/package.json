{
  "name": "reverse-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "A hand-written HTTP reverse proxy / load balancer (H11). Zero runtime dependencies.",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "reverse-proxy": "dist/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
