# Copy to /etc/reverse-proxy.env (root-owned, mode 644). No secrets are needed.
# One URL, or several separated by commas. http:// only, no path.
UPSTREAM=http://127.0.0.1:18080
# Listen on loopback only. Put Caddy (TLS) in front if it must be reachable from outside.
HOST=127.0.0.1
PORT=8080
STRATEGY=round-robin
# true ONLY when a proxy you control (for example Caddy) sits in front and sets X-Forwarded-For.
TRUST_FORWARDED=false
# Active health checks. Remove the next line to use passive ejection only.
HEALTH_PATH=/health
HEALTH_INTERVAL_MS=5000
# Defaults, listed so they are easy to tune after measuring:
# RETRIES=1
# CONNECT_TIMEOUT_MS=3000
# UPSTREAM_TIMEOUT_MS=30000
# EJECT_AFTER=3
# EJECT_MS=10000
# REQUEST_LOG=false     # turn the per-request log line off if throughput matters more than the log
# STATS_INTERVAL_MS=10000
