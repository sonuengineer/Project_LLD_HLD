[Unit]
Description=H11 demo upstream (test server used only to try the proxy service)
After=network-online.target

[Service]
DynamicUser=yes
Environment=PORT=18080 NAME=demo
ExecStart=/opt/node/bin/node /opt/reverse-proxy-demo/upstream.mjs
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=128M

[Install]
WantedBy=multi-user.target
