[Unit]
Description=H11 reverse proxy (load balancer)
After=network-online.target
Wants=network-online.target

[Service]
User=reverse-proxy
Group=reverse-proxy
EnvironmentFile=/etc/reverse-proxy.env
ExecStart=/opt/node/bin/node /opt/reverse-proxy/dist/index.js
Restart=on-failure
RestartSec=2

# SIGTERM starts the graceful shutdown (in-flight requests finish). The proxy force-exits after 10 s,
# so systemd must wait longer than that before it uses SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=15

# Hardening: it only needs to open sockets and read its own files.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryMax=256M

# stdout goes to the journal: one JSON line per request, plus health and stats lines.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
